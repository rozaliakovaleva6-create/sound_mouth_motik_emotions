<?xml version="1.0"?>
<!--
  Главный launch для 3D дисплея (OLED 0x3D).

  По умолчанию (launch_mouth:=true) поднимает ОБЕ ноды:
    1) robot_mouth_talk_node — mouth (осциллограмма + звук)
    2) emotions_display_node — motik (эмоции)

  Только карусель эмоций без рта/звука:
    roslaunch sound_mouth_motik_emotions display_3d.launch launch_mouth:=false cycle_emotions_demo_sec:=2.5
  (ставится /oled_3d/active_driver_default=motik, чтобы сразу рисовалась motik)

  Переключение между ними (когда обе ноды запущены):
    rostopic pub -1 /oled_3d/active__driver std_msgs/String "data: 'mouth'"
    rostopic pub -1 /oled_3d/active__driver std_msgs/String "data: 'motik'"

  По умолчанию активен mouth (осциллограмма). После включения робота
  можно сразу воспроизводить звук:
    rosservice call /oled_mouth/play_audio "data: 'adam-dragon-us_3475244.mp3'"

  Остановить звук:
    rosservice call /oled_mouth/play_audio "data: 'stop'"

  Эмоции (при active_driver=motik):
    rostopic pub -1 /emotions std_msgs/String "data: 'happy'"
    rostopic pub -1 /emotions std_msgs/String "data: 'sad'"
    rostopic pub -1 /emotions std_msgs/String "data: 'neutral'"
-->
<launch>
  <arg name="output_device" default="default" doc="ALSA-устройство (aplay -l)"/>
  <arg name="mouth_sync_hz" default="30" doc="Частота обновления рта (Гц)"/>
  <arg name="default_emotion" default="neutral" doc="Эмоция по умолчанию: happy, sad, neutral"/>
  <!-- 0 = только /emotions; &gt;0 = карусель всех эмоций на OLED (сек на кадр), нужен motik -->
  <arg name="cycle_emotions_demo_sec" default="0" doc="Демо: смена эмоций по кругу, сек (0=выкл)"/>
  <arg name="launch_mouth" default="true" doc="false = не запускать robot_mouth_talk_node (только эмоции)"/>

  <param name="/mouth_sync_hz" value="$(arg mouth_sync_hz)"/>

  <!-- Без mouth: сразу владелец дисплея — motik (иначе emotions ждёт переключения топиком) -->
  <group unless="$(arg launch_mouth)">
    <param name="/oled_3d/active_driver_default" value="motik"/>
  </group>

  <!-- mouth: осциллограмма + звук -->
  <group if="$(arg launch_mouth)">
    <node name="robot_mouth_talk_node" pkg="sound_mouth_motik_emotions" type="robot_mouth_talk_node.py" output="screen">
      <param name="output_device" value="$(arg output_device)"/>
      <param name="rate" value="$(arg mouth_sync_hz)"/>
      <param name="use_oled" value="true"/>
      <param name="mode" value="idle"/>
    </node>
  </group>

  <!-- motik: эмоции -->
  <node name="emotions_display_node" pkg="sound_mouth_motik_emotions" type="emotions_display_node.py" output="screen">
    <param name="default_emotion" value="$(arg default_emotion)"/>
    <param name="cycle_emotions_demo_sec" value="$(arg cycle_emotions_demo_sec)"/>
  </node>
</launch>
